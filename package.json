{
  "name": "openrouter-chat-app",
  "version": "1.0.0",
  "description": "A simple chatbot powered by OpenRouter, with a CLI and a web UI",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:cli": "node dist/index.js",
    "dev": "tsx src/server.ts",
    "dev:cli": "tsx src/index.ts"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.113",
    "dotenv": "^17.0.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
